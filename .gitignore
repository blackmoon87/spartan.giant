# Environment
.env

# Composer
/vendor/

# Cache
/storage/cache/*
!/storage/cache/.gitkeep
/storage/views/*
!/storage/views/.gitignore
!/storage/views/.gitkeep

# Logs
/storage/logs/*
!/storage/logs/.gitkeep
*.log

# Databases
*.sqlite*
# Example demo databases are generated on first request
examples/*/database/*.db
examples/*/database/*.building
examples/*/storage/*.sqlite*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Uploads
/public/uploads/
/storage/uploads/

# Local tooling (not part of the repo)
.TurboQuantex/
codebase_index.tq
/htmlCreator/

# Composer installs (examples resolve the framework through a path repository)
examples/*/vendor/
examples/*/storage/views/*
!examples/*/storage/views/.gitkeep
examples/*/storage/cache/*
!examples/*/storage/cache/.gitkeep
