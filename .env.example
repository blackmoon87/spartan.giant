APP_NAME="PHP MVC Boilerplate"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mvc_skills
DB_USERNAME=root
DB_PASSWORD=

# Read/Write Splitting (optional — leave false for single DB)
DB_READ_WRITE_SPLIT=false
# DB_READ_HOST_1=replica1.example.com
# DB_READ_PORT_1=3306
# DB_READ_HOST_2=replica2.example.com
# DB_READ_PORT_2=3306

# Cache Driver: 'file' (default) or 'redis'
CACHE_DRIVER=file
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Queue Driver: 'database' (default) or 'redis'
QUEUE_DRIVER=database

# Logging: format ('text' default, 'json' for ELK/CloudWatch)
LOG_FORMAT=text
LOG_CHANNEL=app
LOG_LEVEL=DEBUG

RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW=60

# Proxies allowed to set X-Forwarded-For / Client-IP (comma separated).
# Leave EMPTY when the app is reachable directly — otherwise any client can
# forge its IP and bypass rate limiting. Accepts IPs, CIDR ranges, or '*'.
# TRUSTED_PROXIES=10.0.0.0/8,172.16.0.5
TRUSTED_PROXIES=

UPLOAD_PATH=

VIEW_CACHE_ENABLED=false
ROUTE_CACHE_ENABLED=false
