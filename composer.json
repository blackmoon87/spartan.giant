{
    "name": "spartan/framework",
    "description": "Spartan — a readable, dependency-free PHP 8.1+ MVC framework. Router, DI container, query builder, queue, auth and views in ~6k lines you can read end to end.",
    "type": "library",
    "keywords": [
        "framework",
        "mvc",
        "router",
        "micro-framework",
        "php",
        "no-dependencies"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-pdo": "Required for the QueryBuilder, Model layer, migrations and the job queue",
        "ext-redis": "Enables the Redis cache driver (CACHE_DRIVER=redis)"
    },
    "autoload": {
        "psr-4": {
            "Spartan\\": "framework/src/"
        },
        "files": [
            "framework/src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "src/",
            "Spartan\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:kernel": "php tests/run_tests.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "bench": "php tests/stress_test.php",
        "bench:db": "php tests/benchmark_1m_db.php",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
