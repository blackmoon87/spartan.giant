{
    "name": "spartan/example-helpdesk",
    "description": "Spartan example — support helpdesk: auth, roles, policies, uploads, events, queue, cache and a token JSON API.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "spartan/framework": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
