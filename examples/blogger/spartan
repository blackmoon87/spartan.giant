#!/usr/bin/env php
<?php

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    exit("This script can only be run from the command line.\n");
}

$autoloadPath = __DIR__ . '/vendor/autoload.php';
if (file_exists($autoloadPath)) {
    require_once $autoloadPath;
} else {
    // Fallback PSR-4 autoloader so the example runs before `composer install`.
    // In a real project `composer require spartan/framework` provides both.
    $prefixes = [
        'Spartan\\' => dirname(__DIR__, 2) . '/framework/src/',
        'App\\'     => __DIR__ . '/src/',
    ];

    spl_autoload_register(function (string $class) use ($prefixes): void {
        foreach ($prefixes as $prefix => $baseDir) {
            $len = strlen($prefix);
            if (strncmp($prefix, $class, $len) !== 0) {
                continue;
            }
            $file = $baseDir . str_replace('\\', '/', substr($class, $len)) . '.php';
            if (file_exists($file)) {
                require_once $file;
                return;
            }
        }
    });

    require_once dirname(__DIR__, 2) . '/framework/src/helpers.php';
}

use Spartan\Application;
use Spartan\Database\Migrator;
use Spartan\JobQueue;

$config = require __DIR__ . '/config/config.php';
$config['base_path'] ??= __DIR__;
$app = new Application($config);

if ($app->db === null) {
    echo "Error: No database connection. Check .env DB credentials.\n";
    exit(1);
}

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        echo "Running migrations...\n";
        $migrator = new Migrator($app->db);
        try {
            $migrator->migrate();
            echo "Migrations completed successfully!\n";
        } catch (\Throwable $e) {
            echo "Migration failed: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'db:seed':
        echo "Seeding database...\n";
        $seedFile = __DIR__ . '/database/seed.sql';
        if (file_exists($seedFile)) {
            try {
                $sql = file_get_contents($seedFile);
                $app->db->exec($sql);
                echo "Database seeded successfully from database/seed.sql!\n";
            } catch (\Throwable $e) {
                echo "Seeding failed: " . $e->getMessage() . "\n";
                exit(1);
            }
        } else {
            echo "No seed file found at database/seed.sql.\n";
        }
        break;

    case 'worker':
        $loopMode  = in_array('--loop', $argv ?? [], true);
        $pollSecs  = 5;
        echo "Started job queue worker" . ($loopMode ? " in loop mode (polling every {$pollSecs}s)" : '') . ".\n";
        $queue = new JobQueue($app->db);
        do {
            $processed = $queue->processPending();
            if ($processed > 0) {
                echo date('Y-m-d H:i:s') . " — processed {$processed} job(s).\n";
            }
            if ($loopMode) {
                sleep($pollSecs);
            }
        } while ($loopMode);
        echo "Worker stopped.\n";
        break;

    case 'help':
    default:
        echo "Spartan CLI Command Runner\n";
        echo "Usage:\n";
        echo "  php spartan migrate       Run database migrations\n";
        echo "  php spartan db:seed       Seed the database with records\n";
        echo "  php spartan worker        Run the background job worker\n";
        echo "  php spartan worker --loop Run the worker in a continuous loop\n";
        break;
}
