APP_NAME="PHP MVC Boilerplate"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# SQLite demo database, built from migrations + seed on the first request.
DB_CONNECTION=sqlite
DB_DATABASE=database/blogger.db

# MySQL instead (load database/seed_mysql.sql):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=blogger
# DB_USERNAME=root
# DB_PASSWORD=

RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW=60

UPLOAD_PATH=

VIEW_CACHE_ENABLED=false
ROUTE_CACHE_ENABLED=false


# Proxies allowed to set X-Forwarded-For (IPs, CIDRs or *). Empty = ignore them.
TRUSTED_PROXIES=
